{
  "name": "@quynhonsemiconductor/identity",
  "version": "8.4.0",
  "description": "Authentication for QNSC product backends on Better Auth: secure defaults, presets (staff/public/organizations), SSO with encrypted secrets, session guard and a conformance kit. Authorization stays in the product.",
  "license": "UNLICENSED",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./nest": {
      "types": "./dist/nest/index.d.ts",
      "default": "./dist/nest/index.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "default": "./dist/testing/index.js"
    }
  },
  "files": [
    "dist",
    "nest.js",
    "nest.d.ts",
    "testing.js",
    "testing.d.ts",
    "pnpmfile.cjs",
    "MIGRATION-v7-to-v8.md"
  ],
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "restricted"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/quynhonsemiconductor/app-platform.git",
    "directory": "packages/identity"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "rm -rf dist *.tsbuildinfo",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json"
  },
  "dependencies": {
    "@better-auth/core": "1.7.7",
    "@better-auth/drizzle-adapter": "1.7.7",
    "@better-auth/sso": "1.7.7",
    "@node-rs/argon2": "2.2.2",
    "better-auth": "1.7.7",
    "jose": "6.2.4",
    "uuidv7": "1.2.1",
    "zod": "4.6.5"
  },
  "peerDependencies": {
    "@nestjs/common": ">=11",
    "@nestjs/core": ">=11",
    "@quynhonsemiconductor/observability": ">=0.2.3",
    "@quynhonsemiconductor/platform-cache": ">=3.1.0",
    "@quynhonsemiconductor/platform-db": ">=0.1.1",
    "@quynhonsemiconductor/platform-http": ">=4.1.0",
    "drizzle-orm": ">=0.45.2 <1",
    "fastify": ">=5",
    "pg": ">=8.11",
    "ioredis": ">=5"
  },
  "devDependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-fastify": "^11.0.0",
    "@nestjs/swagger": "^11.4.5",
    "@quynhonsemiconductor/observability": "workspace:^",
    "@quynhonsemiconductor/platform-cache": "workspace:^",
    "@quynhonsemiconductor/platform-db": "workspace:^",
    "@quynhonsemiconductor/platform-http": "workspace:^",
    "@quynhonsemiconductor/platform-jobs": "workspace:*",
    "@quynhonsemiconductor/testing": "workspace:*",
    "@types/pg": "8.23.1",
    "auth": "1.7.7",
    "drizzle-kit": "0.31.11",
    "drizzle-orm": "0.45.3",
    "fastify": "^5.12.5",
    "ioredis": "^5.4.1",
    "nestjs-zod": "^5.4.0",
    "pg": "8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "peerDependenciesMeta": {
    "@nestjs/common": {
      "optional": true
    },
    "@nestjs/core": {
      "optional": true
    },
    "fastify": {
      "optional": true
    },
    "@quynhonsemiconductor/observability": {
      "optional": true
    },
    "ioredis": {
      "optional": true
    }
  }
}
