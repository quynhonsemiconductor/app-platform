{
  "name": "@quynhonsemiconductor/platform-jobs",
  "version": "0.1.2",
  "description": "Durable jobs for QNSC product backends on Postgres and pg-boss: transactional enqueue through platform-db's DbExecutor, worker-only handlers (ROLE=worker), schedules, per-queue retention and a graceful stop. NestJS at /nest, test helpers at /testing.",
  "license": "UNLICENSED",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./nest": {
      "types": "./dist/nest/index.d.ts",
      "default": "./dist/nest/index.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "default": "./dist/testing/index.js"
    }
  },
  "files": [
    "dist",
    "nest.js",
    "nest.d.ts",
    "testing.js",
    "testing.d.ts"
  ],
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "restricted"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/quynhonsemiconductor/app-platform.git",
    "directory": "packages/platform-jobs"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "rm -rf dist *.tsbuildinfo",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json"
  },
  "dependencies": {
    "pg-boss": "12.38.0"
  },
  "peerDependencies": {
    "@nestjs/common": ">=11",
    "@nestjs/core": ">=11",
    "@quynhonsemiconductor/observability": ">=0.2.0",
    "@quynhonsemiconductor/platform-db": ">=0.1.1",
    "drizzle-orm": ">=0.45 <1",
    "pg": ">=8.11"
  },
  "peerDependenciesMeta": {
    "@nestjs/common": {
      "optional": true
    },
    "@nestjs/core": {
      "optional": true
    },
    "drizzle-orm": {
      "optional": true
    }
  },
  "devDependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@opentelemetry/api": "^1.9.1",
    "@quynhonsemiconductor/observability": "workspace:^",
    "@quynhonsemiconductor/platform-db": "workspace:^",
    "@quynhonsemiconductor/testing": "workspace:*",
    "@types/pg": "8.23.1",
    "drizzle-orm": "0.45.4",
    "pg": "8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  }
}
