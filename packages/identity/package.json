{
  "name": "@quynhonsemiconductor/identity",
  "version": "6.0.0",
  "description": "Shared authentication mechanism for QNSC product backends: refresh-token rotation with theft detection, Entra/SSO verification, ES256 JWT strategy + guard, and the BFF session flow. Authorization stays in the product.",
  "license": "UNLICENSED",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "default": "./dist/testing/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "restricted"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/quynhonsemiconductor/app-platform.git",
    "directory": "packages/identity"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "rm -rf dist *.tsbuildinfo",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "jose": "^6.2.3",
    "uuidv7": "^1.2.1"
  },
  "peerDependencies": {
    "@quynhonsemiconductor/platform-cache": ">=2.0.0",
    "@quynhonsemiconductor/platform-http": ">=2.0.0",
    "@nestjs/common": ">=11",
    "@nestjs/jwt": ">=11",
    "@nestjs/passport": ">=11",
    "passport": ">=0.7",
    "passport-jwt": ">=4"
  },
  "devDependencies": {
    "@quynhonsemiconductor/platform-cache": "workspace:^",
    "@quynhonsemiconductor/platform-http": "workspace:^",
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/passport": "^11.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/passport-jwt": "^4.0.1",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  }
}
