{
  "name": "@quynhonsemiconductor/platform-runtime",
  "version": "0.3.3",
  "description": "Shared runtime primitives for QNSC product backends: env loading, typed config, /livez and /readyz, graceful shutdown for pod drains, exclusive scheduled jobs, and request-arrival timing.",
  "license": "UNLICENSED",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./load-env": {
      "types": "./dist/config/load-env.d.ts",
      "default": "./dist/config/load-env.js"
    },
    "./bootstrap": {
      "types": "./dist/bootstrap/index.d.ts",
      "default": "./dist/bootstrap/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "restricted"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/quynhonsemiconductor/app-platform.git",
    "directory": "packages/platform-runtime"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "rm -rf dist *.tsbuildinfo",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "peerDependencies": {
    "@nestjs/common": ">=11",
    "@nestjs/config": ">=4",
    "@nestjs/core": ">=11",
    "@quynhonsemiconductor/observability": ">=0.5.0",
    "@quynhonsemiconductor/platform-cache": ">=3.2.0",
    "fastify": ">=5",
    "zod": ">=4.6.6",
    "@quynhonsemiconductor/platform-db": ">=0.1.0",
    "@nestjs/platform-fastify": ">=11",
    "nestjs-pino": ">=4",
    "pino": ">=9"
  },
  "peerDependenciesMeta": {
    "fastify": {
      "optional": true
    },
    "@quynhonsemiconductor/platform-db": {
      "optional": true
    },
    "@nestjs/platform-fastify": {
      "optional": true
    },
    "nestjs-pino": {
      "optional": true
    },
    "pino": {
      "optional": true
    }
  },
  "devDependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/config": "^4.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-fastify": "11.2.7",
    "@quynhonsemiconductor/observability": "workspace:^",
    "@quynhonsemiconductor/platform-cache": "workspace:^",
    "@quynhonsemiconductor/platform-db": "workspace:^",
    "@quynhonsemiconductor/testing": "workspace:*",
    "@types/pg": "8.23.1",
    "fastify": "^5.12.7",
    "pg": "8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.4.3",
    "nestjs-pino": "^4.6.1",
    "pino": "^10.3.1"
  }
}
