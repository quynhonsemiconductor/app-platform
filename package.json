{
  "name": "qnsc-app-platform",
  "version": "0.0.0",
  "private": true,
  "license": "UNLICENSED",
  "packageManager": "pnpm@11.28.6",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=11.0.0"
  },
  "scripts": {
    "build": "pnpm -r --stream build",
    "clean": "pnpm -r --stream clean",
    "typecheck": "pnpm -r --stream typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"packages/**/*.{ts,json,md}\" \"tools/**/*.{ts,mjs,json,md}\" \"docs/**/*.md\" \".github/**/*.{yml,yaml,json,md}\" \"*.{json,md}\"",
    "format:check": "prettier --check \"packages/**/*.{ts,json,md}\" \"tools/**/*.{ts,mjs,json,md}\" \"docs/**/*.md\" \".github/**/*.{yml,yaml,json,md}\" \"*.{json,md}\"",
    "commitlint": "commitlint"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.6.0",
    "@commitlint/config-conventional": "^19.6.0",
    "@eslint/js": "^9.17.0",
    "@types/node": "^24.19.1",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^9.17.0",
    "prettier": "^3.4.2",
    "semver": "7.8.5",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.18.0",
    "vitest": "^4.1.11"
  }
}
