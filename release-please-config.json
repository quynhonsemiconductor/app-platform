{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "release-type": "node",
  "bump-minor-pre-major": true,
  "bump-patch-for-minor-pre-major": true,
  "draft": false,
  "prerelease": false,
  "separate-pull-requests": true,
  "include-component-in-tag": true,
  "include-v-in-tag": true,
  "tag-separator": "-",
  "changelog-sections": [
    {
      "type": "feat",
      "section": "✨ Features"
    },
    {
      "type": "fix",
      "section": "🐛 Bug Fixes"
    },
    {
      "type": "perf",
      "section": "⚡ Performance"
    },
    {
      "type": "refactor",
      "section": "♻️ Refactors",
      "hidden": false
    },
    {
      "type": "security",
      "section": "🔒 Security"
    },
    {
      "type": "deps",
      "section": "📦 Dependencies"
    },
    {
      "type": "chore",
      "section": "🔧 Chores",
      "hidden": true
    },
    {
      "type": "ci",
      "section": "👷 CI/CD",
      "hidden": true
    },
    {
      "type": "docs",
      "section": "📚 Docs",
      "hidden": true
    },
    {
      "type": "test",
      "section": "✅ Tests",
      "hidden": true
    }
  ],
  "packages": {
    "packages/identity": {
      "package-name": "@quynhonsemiconductor/identity",
      "component": "identity",
      "changelog-path": "CHANGELOG.md"
    },
    "packages/platform-cache": {
      "package-name": "@quynhonsemiconductor/platform-cache",
      "component": "platform-cache",
      "changelog-path": "CHANGELOG.md"
    },
    "packages/platform-http": {
      "package-name": "@quynhonsemiconductor/platform-http",
      "component": "platform-http",
      "changelog-path": "CHANGELOG.md"
    },
    "packages/observability": {
      "package-name": "@quynhonsemiconductor/observability",
      "component": "observability",
      "changelog-path": "CHANGELOG.md"
    },
    "packages/platform-runtime": {
      "package-name": "@quynhonsemiconductor/platform-runtime",
      "component": "platform-runtime",
      "changelog-path": "CHANGELOG.md"
    }
  },
  "pull-request-title-pattern": "chore(release): ${component} ${version}",
  "pull-request-header": "🤖 Opened by Release Please. Merging tags `${component}-v${version}` and publishes the package to GitHub Packages."
}
