{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "release-type": "node",
  "bump-minor-pre-major": true,
  "bump-patch-for-minor-pre-major": true,
  "draft": false,
  "prerelease": false,
  "separate-pull-requests": true,
  "include-component-in-tag": true,
  "include-v-in-tag": true,
  "tag-separator": "-",
  "changelog-sections": [
    {
      "type": "feat",
      "section": "\u2728 Features"
    },
    {
      "type": "fix",
      "section": "\ud83d\udc1b Bug Fixes"
    },
    {
      "type": "perf",
      "section": "\u26a1 Performance"
    },
    {
      "type": "refactor",
      "section": "\u267b\ufe0f Refactors",
      "hidden": false
    },
    {
      "type": "security",
      "section": "\ud83d\udd12 Security"
    },
    {
      "type": "deps",
      "section": "\ud83d\udce6 Dependencies"
    },
    {
      "type": "chore",
      "section": "\ud83d\udd27 Chores",
      "hidden": true
    },
    {
      "type": "ci",
      "section": "\ud83d\udc77 CI/CD",
      "hidden": true
    },
    {
      "type": "docs",
      "section": "\ud83d\udcda Docs",
      "hidden": true
    },
    {
      "type": "test",
      "section": "\u2705 Tests",
      "hidden": true
    }
  ],
  "packages": {
    "packages/identity": {
      "package-name": "@quynhonsemiconductor/identity",
      "component": "identity",
      "changelog-path": "CHANGELOG.md"
    },
    "packages/platform-cache": {
      "package-name": "@quynhonsemiconductor/platform-cache",
      "component": "platform-cache",
      "changelog-path": "CHANGELOG.md"
    },
    "packages/platform-http": {
      "package-name": "@quynhonsemiconductor/platform-http",
      "component": "platform-http",
      "changelog-path": "CHANGELOG.md"
    },
    "packages/observability": {
      "package-name": "@quynhonsemiconductor/observability",
      "component": "observability",
      "changelog-path": "CHANGELOG.md"
    }
  },
  "pull-request-title-pattern": "chore(release): ${component} ${version}",
  "pull-request-header": "\ud83e\udd16 Opened by Release Please. Merging tags `${component}-v${version}` and publishes the package to GitHub Packages."
}
