{
  "name": "@qnsc-vn/observability",
  "version": "0.1.6",
  "description": "Shared observability primitives for QNSC product backends: OpenTelemetry bootstrap, pino logger factory with redaction, and AsyncLocalStorage request/job context.",
  "license": "UNLICENSED",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./otel": {
      "types": "./dist/otel.bootstrap.d.ts",
      "default": "./dist/otel.bootstrap.js"
    }
  },
  "files": [
    "dist",
    "otel.js",
    "otel.d.ts"
  ],
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "restricted"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/QNSC-VN/qnsc-app-platform.git",
    "directory": "packages/observability"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "rm -rf dist *.tsbuildinfo",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "peerDependencies": {
    "@opentelemetry/api": ">=1.9",
    "@opentelemetry/auto-instrumentations-node": ">=0.78",
    "@opentelemetry/exporter-metrics-otlp-http": ">=0.220",
    "@opentelemetry/exporter-trace-otlp-http": ">=0.220",
    "@opentelemetry/resources": ">=2",
    "@opentelemetry/sdk-metrics": ">=2",
    "@opentelemetry/sdk-node": ">=0.220",
    "@opentelemetry/sdk-trace-base": ">=2",
    "@opentelemetry/semantic-conventions": ">=1.41",
    "nestjs-pino": ">=4",
    "@nestjs/common": ">=11"
  },
  "devDependencies": {
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/auto-instrumentations-node": "^0.78.0",
    "@opentelemetry/exporter-metrics-otlp-http": "^0.220.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.220.0",
    "@opentelemetry/resources": "^2.9.0",
    "@opentelemetry/sdk-metrics": "^2.9.0",
    "@opentelemetry/sdk-node": "^0.220.0",
    "@opentelemetry/sdk-trace-base": "^2.9.0",
    "@opentelemetry/semantic-conventions": "^1.41.1",
    "nestjs-pino": "^4.6.1",
    "pino": "^10.3.1",
    "reflect-metadata": "^0.2.2",
    "@nestjs/common": "^11.0.0",
    "@opentelemetry/context-async-hooks": "^2.9.0"
  }
}
